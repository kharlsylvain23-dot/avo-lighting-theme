<header class="site-header" data-section-id="{{ section.id }}">
  <div class="header-container">
    <div class="header-left">
      <button class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <nav class="header-nav desktop-only">
        <a href="/" class="nav-link {% if template.name == 'index' %}active{% endif %}">Home</a>
        <a href="/pages/about" class="nav-link">Our Story</a>
        <a href="/blogs/news" class="nav-link">Blog</a>
      </nav>
    </div>

    <div class="header-center">
      <a href="/" class="logo-link">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            class="logo-image"
            width="200"
            height="auto"
            loading="eager"
          >
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="header-right">
      <a href="/account" class="header-icon" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a href="/cart" class="header-icon cart-icon" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav">
      <a href="/" class="mobile-nav-link">Home</a>
      <a href="/pages/about" class="mobile-nav-link">Our Story</a>
      <a href="/blogs/news" class="mobile-nav-link">Blog</a>
      <a href="/account" class="mobile-nav-link">My Account</a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ]
}
{% endschema %}
