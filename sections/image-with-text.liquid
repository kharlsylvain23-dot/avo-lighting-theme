<section class="image-with-text" data-section-id="{{ section.id }}">
  <div class="section-container">
    <div class="iwt-grid {% if section.settings.image_position == 'right' %}iwt-grid--reversed{% endif %}">
      <div class="iwt-image-col">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 700 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading }}"
            class="iwt-image"
            width="700"
            height="700"
            loading="lazy"
          >
        {% else %}
          <div class="iwt-placeholder">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="0.5">
              <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>
            </svg>
          </div>
        {% endif %}
      </div>
      <div class="iwt-text-col">
        <span class="section-overline">{{ section.settings.overline | default: 'Our Philosophy' }}</span>
        <h2 class="iwt-heading">{{ section.settings.heading | default: 'Light That Inspires' }}</h2>
        <div class="iwt-text rte">{{ section.settings.text | default: '<p>At Avo Lighting, we believe that the right light transforms not just a room, but a moment. Each lamp in our collection is thoughtfully designed to blend artistry with function, creating pieces that are as beautiful unlit as they are when they glow.</p><p>From the materials we source to the finishes we apply, every detail reflects our commitment to quality and timeless design.</p>' }}</div>
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "section-iwt",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Light That Inspires"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At Avo Lighting, we believe that the right light transforms not just a room, but a moment. Each lamp in our collection is thoughtfully designed to blend artistry with function.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
