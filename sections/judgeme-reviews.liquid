{%- assign product = section.settings.product -%}

<section class="reviews-section" id="reviews" data-section-id="{{ section.id }}">
  <div class="section-container">
    {%- if section.settings.overline != blank -%}
      <span class="section-overline">{{ section.settings.overline }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="judgeme-widget-wrapper">
      {%- if product != blank -%}
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
          {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', jm_style: '', product: product %}
        </div>
      {%- else -%}
        <p class="reviews-placeholder">Select a product in section settings to display Judge.me reviews.</p>
      {%- endif -%}
    </div>

    {%- comment -%} App blocks for additional review widgets {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline text",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Customers Are Saying"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
