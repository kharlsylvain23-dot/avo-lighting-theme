<section class="product-page">
  <div class="product-page__container">
    <div class="product-page__media">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: product.title }}
      {% else %}
        <div class="product-page__placeholder">Product image</div>
      {% endif %}
    </div>

    <div class="product-page__info">
      <p class="product-page__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price-tag" id="ProductPrice">
        {{ product.selected_or_first_available_variant.price | money }}
      </div>

      {% if product.compare_at_price_max > product.price %}
        <div class="product-page__compare-price">
          Compare at {{ product.compare_at_price_max | money }}
        </div>
      {% endif %}

      {% if product.description != blank %}
        <div class="product-page__description">
          {{ product.description }}
        </div>
      {% endif %}

      {% form 'product', product, class: 'product-page__form' %}
        <label class="product-page__label" for="ProductVariant">Choose option</label>

        <select id="ProductVariant" name="id" class="product-page__select">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
            </option>
          {% endfor %}
        </select>

        <div class="product-page__actions">
          <button
            class="product-page__button product-page__button--primary"
            type="submit"
            name="add"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {% if product.selected_or_first_available_variant.available %}
              Add to cart
            {% else %}
              Sold out
            {% endif %}
          </button>

          <button
            class="product-page__button"
            type="submit"
            name="checkout"
          >
            Buy now
          </button>
        </div>
      {% endform %}

      <div class="product-page__trust">
        <span>Secure checkout</span>
        <span>Fast shipping</span>
        <span>Easy returns</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured product"
    }
  ]
}
{% endschema %}
