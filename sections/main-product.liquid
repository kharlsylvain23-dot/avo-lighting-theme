{%- assign product = section.settings.product | default: product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- if product != blank -%}
<!-- JSON-LD structured data for SEO & dropshipping product linking -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [
    {%- for image in product.images -%}
      "{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "sku": {{ current_variant.sku | json }},
  {%- if current_variant.barcode != blank -%}
  "gtin": {{ current_variant.barcode | json }},
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    {%- if current_variant.compare_at_price > current_variant.price -%}
    "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-12-31",
    {%- endif -%}
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
}
</script>
{%- endif -%}

<section class="product-main" id="buy" data-section-id="{{ section.id }}">
  <div class="section-container">
    {%- if product != blank -%}
    <div class="product-grid">
      <div class="product-media">
        <div class="product-media-main">
          {%- if product.featured_image != blank -%}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="product-featured-image"
              width="800"
              height="800"
              id="product-main-image"
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="product-thumbnails">
            {%- for image in product.images -%}
              <button
                class="product-thumbnail {% if forloop.first %}active{% endif %}"
                data-image-url="{{ image | image_url: width: 800 }}"
                data-index="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 100 }}"
                  alt="{{ image.alt | escape }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product-info">
        <div class="product-info-inner">
          {%- if product.vendor != blank -%}
            <p class="product-vendor">{{ product.vendor }}</p>
          {%- endif -%}

          <h2 class="product-title">{{ product.title }}</h2>

          <!-- Review app summary hook — apps like Judge.me, Loox, Stamped inject here -->
          <div class="product-reviews-summary" id="product-reviews-summary">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>

          <div class="product-price" data-product-price>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
              <span class="price-badge">Sale</span>
            {%- endif -%}
            <span class="price-current">{{ current_variant.price | money }}</span>
          </div>

          {%- form 'product', product, id: 'product-form', data-product-form: '', data-product-id: product.id -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="product-option">
                  <label class="product-option-label" for="option-{{ option.name | handleize }}">
                    {{ option.name }}
                  </label>
                  <select
                    id="option-{{ option.name | handleize }}"
                    class="product-option-select"
                    name="options[{{ option.name }}]"
                    data-option-index="{{ forloop.index0 }}"
                  >
                    {%- for value in option.values -%}
                      <option
                        value="{{ value }}"
                        {% if option.selected_value == value %}selected{% endif %}
                      >
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <div class="product-quantity">
              <label class="product-option-label" for="quantity">Quantity</label>
              <div class="quantity-selector">
                <button type="button" class="qty-btn qty-minus" aria-label="Decrease quantity">−</button>
                <input type="number" id="quantity" name="quantity" value="1" min="1" class="qty-input" aria-label="Quantity">
                <button type="button" class="qty-btn qty-plus" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <button
              type="submit"
              class="btn btn-primary btn-add-to-cart"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>

            <!-- Trust badges for dropshipping -->
            <div class="trust-badges">
              <div class="trust-badge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Secure Checkout</span>
              </div>
              <div class="trust-badge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="m16 8 4 2v6l-4 2"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <span>Free Shipping</span>
              </div>
              <div class="trust-badge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                <span>Easy Returns</span>
              </div>
            </div>
          {%- endform -%}

          <div class="product-description rte">
            {{ product.description }}
          </div>

          {%- if product.metafields.descriptors.care_guide.value != blank -%}
            <div class="product-care">
              <h3>Care Instructions</h3>
              <p>{{ product.metafields.descriptors.care_guide.value }}</p>
            </div>
          {%- endif -%}

          <!-- Shipping / estimated delivery info for dropshipping -->
          <div class="product-shipping-info">
            <div class="shipping-detail">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{{ section.settings.shipping_estimate | default: 'Estimated delivery: 5–12 business days' }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Dedicated review widget section — third party apps render full reviews here -->
    <div class="product-reviews-full" id="product-reviews-full">
    </div>

    <!-- Product JSON for variant switching -->
    <script type="application/json" id="product-json">
      {{ product | json }}
    </script>

    {%- else -%}
    <!-- No product selected — shown in theme editor -->
    <div class="product-empty-state">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="0.5">
        <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>
      </svg>
      <p>Select your lamp product in this section's settings.</p>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product — Buy section",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "shipping_estimate",
      "label": "Shipping estimate text",
      "default": "Estimated delivery: 5–12 business days"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product — Buy section"
    }
  ]
}
{% endschema %}
