<div class="customer-page">
  <div class="section-container section-container--narrow">
    <h1 class="customer-title">Activate Your Account</h1>
    <p>Create a password to activate your account.</p>

    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}

      <div class="form-group">
        <label for="ActivatePassword">Password</label>
        <input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
      </div>

      <div class="form-group">
        <label for="ActivatePasswordConfirm">Confirm Password</label>
        <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-full">Activate Account</button>
      <div class="customer-links">
        <a href="/account/login">Decline invitation</a>
      </div>
    {%- endform -%}
  </div>
</div>
