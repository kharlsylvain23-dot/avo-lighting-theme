<div class="customer-page">
  <div class="section-container section-container--narrow">
    <h1 class="customer-title">Sign In</h1>

    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}

      <div class="form-group">
        <label for="CustomerEmail">Email</label>
        <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
      </div>

      <div class="form-group">
        <label for="CustomerPassword">Password</label>
        <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-full">Sign In</button>

      <div class="customer-links">
        <a href="/account/register">Create an account</a>
        <a href="#recover" id="RecoverLink">Forgot your password?</a>
      </div>
    {%- endform -%}

    <!-- Password recovery form -->
    <div id="RecoverForm" style="display:none;">
      <h2 class="customer-subtitle">Reset Your Password</h2>
      <p>We will send you an email to reset your password.</p>

      {%- form 'recover_customer_password' -%}
        {{ form.errors | default_errors }}

        {%- if form.posted_successfully? -%}
          <p class="form-success">We've sent you an email with a link to update your password.</p>
        {%- endif -%}

        <div class="form-group">
          <label for="RecoverEmail">Email</label>
          <input type="email" name="email" id="RecoverEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Submit</button>
        <div class="customer-links">
          <a href="#" id="HideRecoverLink">Back to login</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var recoverLink = document.getElementById('RecoverLink');
    var hideLink = document.getElementById('HideRecoverLink');
    var recoverForm = document.getElementById('RecoverForm');
    var loginForm = recoverForm ? recoverForm.previousElementSibling : null;

    if (recoverLink) {
      recoverLink.addEventListener('click', function(e) {
        e.preventDefault();
        recoverForm.style.display = 'block';
        if (loginForm && loginForm.tagName === 'FORM') loginForm.style.display = 'none';
      });
    }
    if (hideLink) {
      hideLink.addEventListener('click', function(e) {
        e.preventDefault();
        recoverForm.style.display = 'none';
        if (loginForm && loginForm.tagName === 'FORM') loginForm.style.display = 'block';
      });
    }
    if (window.location.hash === '#recover') {
      recoverForm.style.display = 'block';
      if (loginForm && loginForm.tagName === 'FORM') loginForm.style.display = 'none';
    }
  })();
</script>
